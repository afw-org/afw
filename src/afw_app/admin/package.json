    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@mui/x-tree-view": "^9.13.0",
    "cross-env": "^7.0.3",
    "material-design-icons-iconfont": "^6.1.0",
    "mdi-material-ui": "^8.0.0",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "typeface-roboto": "^1.1.13",
    "typeface-roboto-mono": "^1.1.13",
    "vis-network": "^10.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.5.0",
    "jsdom": "^24.0.0",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "vite": "^5.2.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^1.6.1"
  },
  "scripts": {
    "prestart": "./prestart.sh",
    "start": "vite",
    "analyze": "cross-env ANALYZE=true vite build",
    "build": "vite build",
    "test": "cross-env TZ=UTC vitest run",
    "test-p": "cross-env TZ=UTC npm-run-all --parallel --aggregate-output test:app test:objects test:models test:services test:admin test:tools test:docs",
    "test:app": "cross-env TZ=UTC vitest run src/App src/Home",
    "test:objects": "cross-env TZ=UTC vitest run src/Objects",
    "test:models": "cross-env TZ=UTC vitest run src/Admin/Models",
    "test:services": "cross-env TZ=UTC vitest run src/Admin/Services",
    "test:admin": "cross-env TZ=UTC vitest run src/Admin/Application src/Admin/Authorization src/Admin/Extensions src/Admin/Provisioning src/Admin/RequestHandlers src/Admin/Schema src/Admin/Server src/Admin/Status src/Admin/Versions",
    "test:tools": "cross-env TZ=UTC vitest run src/Tools",
    "test:docs": "cross-env TZ=UTC vitest run src/Documentation"
  }
}
