{
    "serviceId": "adapter-lmdb",
    "startup": "immediate",
    "conf": {
        "type": "adapter",
        "adapterType": "lmdb",
        "adapterId": "lmdb",
        "limits": {
            "time": { "hard": 60, "soft": 30 },
            "size": { "hard": 100000, "soft": 100000 }
        },
        "env": {
            "mapsize": 33554432,
            "maxdbs": 32,
            "maxreaders": 126,
            "mode": 384,
            "path": "lmdb/"
        }
    }
}
