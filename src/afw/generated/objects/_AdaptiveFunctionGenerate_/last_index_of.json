{
    "afwCamelCaseFunctionLabel": "afwLastIndexOf",
    "brief": "Returns index of last occurrence",
    "camelCaseFunctionLabel": "lastIndexOf",
    "category": "polymorphic",
    "dataTypeMethod": true,
    "description": "Returns the zero-based index into <dataType> value of the last occurrence of a subString. If subString is not found, -1 is returned.",
    "functionId": "last_index_of",
    "functionLabel": "last_index_of",
    "parameters": [
        {
            "description": "The <dataType> value to search.",
            "name": "value",
            "polymorphicDataType": true
        },
        {
            "dataType": "string",
            "description": "Substring to search for.",
            "name": "subString"
        },
        {
            "dataType": "integer",
            "description": "Optional start index for search if different than start of string.",
            "name": "startIndex",
            "optional": true
        }
    ],
    "polymorphic": true,
    "polymorphicDataTypes": [
        "anyURI",
        "array",
        "string"
    ],
    "polymorphicExecuteFunction": "afw_function_execute_last_index_of",
    "polymorphicOverrides": {
        "array": {
            "brief": "Index of the last array entry equal to a value",
            "description": "Return the index of the last entry of array equal to searchElement, searching backward from fromIndex, or -1. Values are compared as includes compares them: by value (equal arrays and objects match), and NaN is found.",
            "parameters": [
                {
                    "dataType": "array",
                    "description": "The array to search.",
                    "name": "array",
                    "polymorphicDataType": true
                },
                {
                    "canBeUndefined": true,
                    "description": "The value to find.",
                    "name": "searchElement"
                },
                {
                    "dataType": "integer",
                    "description": "Index to start the search at, searching backward. Negative counts from the end. Default: the last index.",
                    "name": "fromIndex",
                    "optional": true
                }
            ],
            "returns": {
                "dataType": "integer",
                "description": "The index found, or -1."
            },
            "useExecuteFunction": "afw_function_execute_last_index_of_array"
        }
    },
    "pure": true,
    "returns": {
        "dataType": "integer",
        "description": "Zero-based index of subString or -1 if not found."
    },
    "useExecuteFunction": "AFW_FUNCTION_EXECUTE_STANDARD_POLYMORPHIC_FUNCTION_HANDLING"
}