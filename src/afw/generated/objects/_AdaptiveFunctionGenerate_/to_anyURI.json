{
    "afwCamelCaseFunctionLabel": "afwToAnyURI",
    "brief": "Converts string to anyURI",
    "camelCaseFunctionLabel": "toAnyURI",
    "category": "polymorphic",
    "dataTypeMethod": true,
    "description": "Converts <dataType> value to anyURI. A string is read as anyURI text, the same text the typed literal \"...\"anyURI accepts, and text that is not valid anyURI is an error.",
    "errorsThrown": [
        {
            "error": "conversion_error",
            "reason": "value is not valid anyURI text"
        }
    ],
    "functionId": "to_anyURI",
    "functionLabel": "to_anyURI",
    "parameters": [
        {
            "name": "value",
            "polymorphicDataType": true
        }
    ],
    "polymorphic": true,
    "polymorphicDataTypes": [
        "string"
    ],
    "polymorphicExecuteFunction": "afw_function_execute_convert",
    "pure": true,
    "returns": {
        "dataType": "anyURI"
    },
    "useExecuteFunction": "AFW_FUNCTION_EXECUTE_STANDARD_POLYMORPHIC_FUNCTION_HANDLING"
}