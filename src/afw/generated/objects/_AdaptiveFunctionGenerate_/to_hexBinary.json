{
    "afwCamelCaseFunctionLabel": "afwToHexBinary",
    "brief": "Converts string to hexBinary",
    "camelCaseFunctionLabel": "toHexBinary",
    "category": "polymorphic",
    "dataTypeMethod": true,
    "description": "Converts <dataType> value to hexBinary. A string is read as hexBinary text, the same text the typed literal \"...\"hexBinary accepts, and text that is not valid hexBinary is an error.",
    "errorsThrown": [
        {
            "error": "conversion_error",
            "reason": "value is not valid hexBinary text"
        }
    ],
    "functionId": "to_hexBinary",
    "functionLabel": "to_hexBinary",
    "parameters": [
        {
            "name": "value",
            "polymorphicDataType": true
        }
    ],
    "polymorphic": true,
    "polymorphicDataTypes": [
        "string"
    ],
    "polymorphicExecuteFunction": "afw_function_execute_convert",
    "pure": true,
    "returns": {
        "dataType": "hexBinary"
    },
    "useExecuteFunction": "AFW_FUNCTION_EXECUTE_STANDARD_POLYMORPHIC_FUNCTION_HANDLING"
}