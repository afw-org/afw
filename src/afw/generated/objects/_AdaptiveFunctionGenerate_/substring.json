    "parameters": [
        {
            "name": "string",
            "polymorphicDataType": true
        },
        {
            "dataType": "integer",
            "name": "startIndex"
        },
        {
            "dataType": "integer",
            "name": "endIndex",
            "optional": true
        }
    ],
    "polymorphic": true,
    "polymorphicDataTypes": [
        "anyURI",
        "string"
    ],
    "polymorphicExecuteFunction": "afw_function_execute_substring",
    "pure": true,
    "returns": {
        "dataType": "string",
        "description": "Substring as string (not re-typed as the input data type)."
    },
    "useExecuteFunction": "AFW_FUNCTION_EXECUTE_STANDARD_POLYMORPHIC_FUNCTION_HANDLING"
}