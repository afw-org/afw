{
    "brief": "Converts string to rfc822Name",
    "category": "polymorphic",
    "dataTypeMethod": true,
    "description": "Converts <dataType> value to rfc822Name. A string is read with the rfc822Name parser, the same parser the typed literal \"...\"rfc822Name uses, and text the parser rejects is an error.",
    "errorsThrown": [
        {
            "error": "conversion_error",
            "reason": "the rfc822Name parser rejects the text"
        }
    ],
    "functionId": "to_rfc822Name",
    "functionLabel": "to_rfc822Name",
    "pure": true,
    "parameters": [
        {
            "name": "value",
            "polymorphicDataType": true
        }
    ],
    "polymorphic": true,
    "polymorphicDataTypes": [
        "string"
    ],
    "polymorphicExecuteFunction": "afw_function_execute_convert",
    "returns": {
        "dataType": "rfc822Name"
    }
}