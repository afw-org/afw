            "error": "conversion_error",
            "reason": "value is not valid ipAddress text"
        }
    ],
    "functionId": "to_ipAddress",
    "functionLabel": "to_ipAddress",
    "pure": true,
    "parameters": [
        {
            "name": "value",
            "polymorphicDataType": true
        }
    ],
    "polymorphic": true,
    "polymorphicDataTypes": [
        "string"
    ],
    "polymorphicExecuteFunction": "afw_function_execute_convert",
    "returns": {
        "dataType": "ipAddress"
    }
}