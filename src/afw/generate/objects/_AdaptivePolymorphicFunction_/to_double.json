{
    "brief": "Converts to double",
    "category": "polymorphic",
    "dataTypeMethod": true,
    "description": "Converts <dataType> value to double. A string is read as double text, the same text a double literal accepts, and other text is an error: integer text such as \"5\" is not a double, so use to_double(to_integer(s)) for it.",
    "errorsThrown": [
        {
            "error": "conversion_error",
            "reason": "value is not valid double text"
        }
    ],
    "functionId": "to_double",
    "functionLabel": "to_double",
    "pure": true,
    "parameters": [
        {
            "name": "value",
            "polymorphicDataType": true
        }
    ],
    "polymorphic": true,
    "polymorphicDataTypes": [
        "integer",
        "string"
    ],
    "polymorphicExecuteFunction": "afw_function_execute_convert",
    "polymorphicOverrides": {
        "integer": {
            "useExecuteFunction": "afw_function_execute_to_double_integer"
        }
    },
    "returns": {
        "dataType": "double"
    }
}