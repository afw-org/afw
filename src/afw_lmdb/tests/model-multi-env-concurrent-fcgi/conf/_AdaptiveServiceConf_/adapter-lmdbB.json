{
    "serviceId": "adapter-lmdbB",
    "startup": "immediate",
    "conf": {
        "type": "adapter",
        "adapterType": "lmdb",
        "adapterId": "lmdbB",
        "description": "LMDB env B: written and read only from model on* scripts",
        "limits": {
            "time": { "hard": 60, "soft": 30 },
            "size": { "hard": 100000, "soft": 100000 }
        },
        "env": {
            "mapsize": 104857600,
            "maxdbs": 32,
            "maxreaders": 126,
            "mode": 384,
            "path": "lmdbB/"
        }
    }
}
