<doxygenlayout version="1.0">
  <!-- AFW C-focused layout: modules first, data structures without C++ hierarchy.
       Wired via Doxyfile LAYOUT_FILE. Regenerated/customized from doxygen 1.9.1. -->
  <navindex>
    <tab type="mainpage" visible="yes" title=""/>
    <tab type="modules" visible="yes" title="Modules" intro=""/>
    <!-- Developer MD pages (src/afw/doc/developer/*.md) -->
    <tab type="pages" visible="yes" title="Related Pages" intro=""/>
    <!-- C types: OPTIMIZE_OUTPUT_FOR_C maps "classes" to data structures -->
    <tab type="classes" visible="yes" title="Data Structures">
      <tab type="classlist" visible="yes" title="Data Structure List" intro=""/>
      <tab type="classindex" visible="$ALPHABETICAL_INDEX" title="Data Structure Index"/>
      <tab type="hierarchy" visible="no" title=""/>
      <tab type="classmembers" visible="yes" title="Data Fields"/>
    </tab>
    <tab type="namespaces" visible="no" title=""/>
    <tab type="interfaces" visible="no" title=""/>
    <tab type="structs" visible="no" title=""/>
    <tab type="exceptions" visible="no" title=""/>
    <tab type="files" visible="yes" title="Files">
      <tab type="filelist" visible="yes" title="File List" intro=""/>
      <tab type="globals" visible="yes" title="Globals"/>
    </tab>
    <tab type="examples" visible="no" title=""/>
  </navindex>

  <!-- Layout definition for a class/struct page -->
  <class>
