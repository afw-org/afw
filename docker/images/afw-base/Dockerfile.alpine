# Keep OS_VERSION in step with afw-dev-base/Dockerfile.alpine: afw and
# afwfcgi are compiled there and run here. Bump both together, then rebuild
# and publish this image too.
ARG OS_VERSION=3.24
FROM alpine:${OS_VERSION}

LABEL org.opencontainers.image.source=https://github.com/afw-org/afw

RUN apk add --no-cache icu-libs fcgi \
    libxml2 libunwind elfutils curl db lmdb yaml libldap libedit nginx
