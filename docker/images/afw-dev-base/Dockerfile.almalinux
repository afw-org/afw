FROM almalinux:9

LABEL org.opencontainers.image.source=https://github.com/afw-org/afw

# Install packages
# Includes AddressSanitizer/UBSan runtimes for gcc and clang plus
# llvm-symbolizer, for sanitizer runs; afwdev test does not use them yet.
RUN dnf install -y epel-release && \
    dnf install -y 'dnf-command(config-manager)' && \
    dnf install -y glibc-langpack-en && \
    dnf config-manager --set-enabled crb && \
    dnf group install "Development Tools" -y && \
    dnf --enablerepo=crb install -y \
    make libtool cmake clang-analyzer \
    nginx gdb gdb-gdbserver valgrind valgrind-devel \
    libxml2-devel libxslt-devel libicu-devel \
    elfutils elfutils-devel libunwind-devel \
    httpd-devel mariadb mariadb-devel lmdb lmdb-devel \
    libcurl-devel libyaml libyaml-devel libedit-devel \
    python3-pip python3-devel \
    fcgi fcgi-devel wget git \
    rpm-build npm \
    openldap-devel openldap-servers \
    libasan libubsan compiler-rt llvm \
    openssl openssl-devel doxygen && \
    dnf install -y --allowerasing libcurl && \
    dnf clean all && rm -rf /var/cache/*

RUN npm install -g npm-upgrade && npm install -g n && n 24
RUN npm install -g npm@10 eclint cspell

# Python tools live in a venv on PATH, not the system site-packages
# (PEP 668). afwdev and its tests find python3/pip through PATH.
ENV VIRTUAL_ENV=/opt/afw-venv
ENV PATH=/opt/afw-venv/bin:$PATH
COPY python-requirements.txt /tmp/python-requirements.txt
RUN python3 -m venv /opt/afw-venv && \
    pip install -r /tmp/python-requirements.txt

CMD [ "bash" ]
