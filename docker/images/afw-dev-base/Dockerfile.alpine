ARG OS_VERSION=3.24
FROM alpine:${OS_VERSION}

LABEL org.opencontainers.image.source=https://github.com/afw-org/afw

RUN apk add --no-cache build-base libtool clang-analyzer py3-clang \
    fcgi-dev libxml2-dev libxslt-dev apache2-dev cmake nginx \
    python3 python3-dev py3-pip valgrind valgrind-dev libunwind-dev \
    elfutils-dev yaml-dev curl-dev icu-libs icu-dev doxygen bash \
    db-dev lmdb-dev libedit-dev git alpine-sdk sudo \
    openldap-dev openldap openldap-back-mdb nodejs npm

# No AddressSanitizer here: neither gcc nor clang ships an ASan runtime
# for musl. Use the glibc afw-dev-base images for sanitizer runs.

# Python tools live in a venv on PATH, not the system site-packages
# (PEP 668). afwdev and its tests find python3/pip through PATH.
ENV VIRTUAL_ENV=/opt/afw-venv
ENV PATH=/opt/afw-venv/bin:$PATH
COPY python-requirements.txt /tmp/python-requirements.txt
RUN python3 -m venv /opt/afw-venv && \
    pip install -r /tmp/python-requirements.txt

CMD [ "bash" ]
